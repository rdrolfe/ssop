# SSOP containment — firewall block/unblock/list via the root-owned wrapper
# (network host only). The wrapper (ssop-containment-iptables.sh) validates the
# IP address and forces the iptables verb/target, so no caller-supplied
# iptables flags can ever match this rule.
rdrolfe ALL=(root) NOPASSWD: /usr/local/sbin/ssop-containment-iptables.sh
