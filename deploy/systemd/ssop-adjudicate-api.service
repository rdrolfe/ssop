[Unit]
Description=SSOP adjudication API (TLS, human console backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rdrolfe
Group=rdrolfe
WorkingDirectory=/home/rdrolfe/agent-runtime
# Bearer-token auth is enforced in the API; the token is read from
# ADJUDICATE_API_TOKEN (agents/config.py Settings) via the runtime .env.
# -m tools.adjudicate_api (not a script path): the module imports
# logging_setup + tools.* which need the runtime root on sys.path.
# Loopback binding (issue #1): the API is reachable only from this host
# (the console proxy on the telemetry host connects over its own channel).
# To expose it beyond loopback, bind 127.0.0.1 here and front it with an
# authenticating reverse proxy (e.g. nginx/caddy) — do NOT bind 0.0.0.0.
ExecStart=/home/rdrolfe/agent-runtime/agent-env/bin/python3 -m tools.adjudicate_api --host 127.0.0.1 --port 8787 --tls
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
