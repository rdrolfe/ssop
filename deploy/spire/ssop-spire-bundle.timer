[Unit]
Description=SSOP SPIRE trust-bundle refresher (agent side)
# The agent does not auto-refresh its trust_bundle_path file; when the
# server CA rotates, a stale bundle breaks attestation (Sep 6: 13k restarts).
# This timer keeps the bundle current and restarts the agent only on change.

[Timer]
OnCalendar=*-*-* 0/6:17:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
