# SSOP configuration template
# Copy to deploy/.env and edit for your environment.
# This file contains NO real secrets — fill in your own values.

# ---- SIEM (Wazuh) ----
# Two conventions supported:
# 1) Simple host/port (agent runtime on the same network as the indexer):
#    WAZUH_INDEXER_HOST=localhost
#    WAZUH_INDEXER_PORT=9200
# 2) Full URL (docker-internal name, e.g. from the compose stack):
#    WAZUH_INDEXER_URL=https://wazuh.indexer:9200
#    (If both are set, a non-localhost WAZUH_INDEXER_HOST wins over the URL's host.)
WAZUH_INDEXER_HOST=localhost
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=changeme_indexer

# ---- Security Onion (optional second backend) ----
# Password for the SO ES user (see agents/transport.yaml backends.securityonion).
# Kept out of transport.yaml on purpose — never commit the real value.
SO_INDEXER_PASSWORD=changeme_so

# ---- Wazuh Manager API (for wazuh:agents etc.) ----
WAZUH_HOST=localhost
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=changeme_api

# ---- Qdrant (case spine + memory) ----
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- Escalation delivery (supervisory agent) ----
# Point at any OpenAI-compatible API. Leave empty to queue-only (file fallback).
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=changeme_hermes

# ---- Analyst thresholds (Wazuh levels 0-15) ----
ANALYST_HIGH_LEVEL=7
ANALYST_MEDIUM_LEVEL=4

# ---- Router tuning ----
ROUTER_BURST_WINDOW_MIN=10
ROUTER_PATTERN_RATE_MINUTES=60
ROUTER_NOISE_RULES=5501,5502

# ---- Self-heal ----
SELFHEAL_DISK_WARN_PCT=85
SELFHEAL_DISK_CRIT_PCT=95
SELFHEAL_TIMEOUT_S=30

# ---- Hosts the infra-manager can reach ----
# Format: name=ip,name=ip  (names are arbitrary labels)
SSH_HOSTS=localhost=127.0.0.1
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_ed25519
SPIRE_SOCKET=/tmp/spire-agent/public/api.sock
SPIRE_BIN=spire-agent

# ---- Runtime dirs (defaults to ~/agent-runtime) ----
# SSOP_RUNTIME_DIR=/home/you/agent-runtime
# AUDIT_DIR=/home/you/agent-runtime/audit
# ESCALATION_DIR=/home/you/agent-runtime/tickets
# ROUTER_STATE=/home/you/agent-runtime/router_state.json

# ---- Proxmox (optional) ----
PROXMOX_HOST=localhost
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=tokenid
PROXMOX_TOKEN_SECRET=changeme_proxmox
PROXMOX_VERIFY_SSL=false

# ---- Audit location ----
AUDIT_DIR=./audit

# ---- SPIRE (optional identity layer) ----
SPIRE_SOCKET=/tmp/spire-agent/public/api.sock
