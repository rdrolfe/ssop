@prefix : <http://ssop.local/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


<http://ssop.local/ontology> a owl:Ontology ;
    rdfs:label "SSOP decision ontology" ;
    rdfs:comment "Machine-readable statement of the SSOP role/authority/decision model. GENERATED by agents/tools/ontology_export.py — do not hand-edit. Phase 2 (check_ontology) runs a reasoner over this." .

## ---- core classes ----

:Alert a owl:Class ;
    rdfs:comment "A normalized SIEM alert (alert contract, issue #25)." .

:Observable a owl:Class ;
    rdfs:comment "An extracted indicator: ip | hash | domain | url." .

:Case a owl:Class ;
    rdfs:comment "A spine case (event-point store, dual-written)." .

:Verdict a owl:Class ;
    rdfs:comment "A role's classification of an alert/case." .

:Decision a owl:Class ;
    rdfs:comment "An authority's approve/deny with rationale." .

:Playbook a owl:Class ;
    rdfs:comment "A whitelisted action sequence under the tier model." .

:TuningEntry a owl:Class ;
    rdfs:comment "A durable human tuning decision (fingerprint + optional exclude_hosts)." .

:Receipt a owl:Class ;
    rdfs:comment "An append-only spine/audit event." .

## ---- role classes (each a:Role) ----

:Role a owl:Class .

:Router a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:comment "Classifies every alert via the single categorizer, applies noise/dedupe/tuning gates, routes to the owning role. Approving authority for INFRA cases only (tier0/1; never tier2)." .

:Analyst a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:comment "First verdict: note | escalate. Attaches observables + enrichments; recommends playbooks (tier1/2 enrichment hook)." .

:Investigator a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:comment "Correlates the entity across sources; produces severity (log-count + kill-chain breadth) and evidence." .

:Supervisory a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:comment "Approve | deny. The verdict AUTHORITY for security cases; writes the tuning ledger (deny -> auto_fp with fingerprint). Sole authority for tier2 run_id approval." .

:Responder a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:comment "Executes playbooks under the tier model. tier0/1 execute on trigger+recommendation; tier2 requires a supervisory run_id (expires in 15 min). Router adjudication authorizes tier0/1 on infra cases; NEVER tier2." .

:Hunt a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:comment "Hypothesis-driven sweeps; findings escalate with playbook recommendations; will consume MISP-style bulk feed matching." .

:Intel a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:comment "Matches KEV/NVD feeds into hunt packs; stages, never promotes." .

:InfraManager a owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:comment "Self-heal: senses fleet health, fixes whitelisted issues, escalates the rest." .

## ---- alert category classes ----

:AlertCategory a owl:Class .

:authentication a owl:Class ;
    rdfs:subClassOf :AlertCategory ;
    rdfs:comment "Authentication events (logins, auth failures, session anomalies). Escalates at medium severity unless pure brute-force noise." .

:threat a owl:Class ;
    rdfs:subClassOf :AlertCategory ;
    rdfs:comment "Attack-class events (ET MALWARE signatures, C2, exfil, malware dns). Escalates even at low level — the indicator is the signal, not Wazuh's level mapping." .

:integrity a owl:Class ;
    rdfs:subClassOf :AlertCategory ;
    rdfs:comment "File-integrity / rootcheck / syscheck events (FIM). Escalates only at category-high level (12) — routine scans are maintenance." .

:compliance a owl:Class ;
    rdfs:subClassOf :AlertCategory ;
    rdfs:comment "Policy / SCA / vulnerability events." .

:operational a owl:Class ;
    rdfs:subClassOf :AlertCategory ;
    rdfs:comment "Routine system events (sessions, services, dpkg) — no dispatch by default." .

:infra a owl:Class ;
    rdfs:subClassOf :AlertCategory ;
    rdfs:comment "Fleet-health events (disk, systemd service health, sudo) — routed to the infra-manager/responder path (fleet-sysadmin role)." .

## ---- approval tiers ----

:Tier a owl:Class .

:tier0 a owl:Class ;
    rdfs:subClassOf :Tier ;
    rdfs:comment "Execute immediately, no approval (verify/known-safe)." .

:tier1 a owl:Class ;
    rdfs:subClassOf :Tier ;
    rdfs:comment "Execute immediately on trigger + recommendation, recorded." .

:tier2 a owl:Class ;
    rdfs:subClassOf :Tier ;
    rdfs:comment "Escalation ticket with run_id + expiry (15 min). Human approval matching the run_id required; supervisory-only." .

## ---- object properties ----

:classifiedAs a owl:ObjectProperty ;
    rdfs:domain :Alert ;
    rdfs:range :AlertCategory ;
    rdfs:comment "Exactly one category per alert (single categorizer)." .

:ownedBy a owl:ObjectProperty ;
    rdfs:domain :Alert ;
    rdfs:range :Role ;
    rdfs:comment "Dispatch: the owning role." .

:hasObservable a owl:ObjectProperty ;
    rdfs:domain :Case ;
    rdfs:range :Observable ;
 .

:hasVerdict a owl:ObjectProperty ;
    rdfs:domain :Alert ;
    rdfs:range :Verdict ;
 .

:hasDecision a owl:ObjectProperty ;
    rdfs:domain :Case ;
    rdfs:range :Decision ;
 .

:approvedBy a owl:ObjectProperty ;
    rdfs:domain :Decision ;
    rdfs:range :Role ;
    rdfs:comment "supervisory for security cases; router for infra cases (tier0/1)." .

:executes a owl:ObjectProperty ;
    rdfs:domain :Responder ;
    rdfs:range :Playbook ;
    rdfs:comment "tier0/1 on trigger+rec." .

:requiresApprovalFrom a owl:ObjectProperty ;
    rdfs:domain :Playbook ;
    rdfs:range :Role ;
    rdfs:comment "tier2 -> Supervisory (run_id + expiry)." .

:tunesRule a owl:ObjectProperty ;
    rdfs:domain :TuningEntry ;
    rdfs:range :Alert ;
    rdfs:comment "Fingerprint-keyed; material delta overrides." .

## ---- authority invariants (axioms; phase 2 proves) ----

:Tier2 a owl:Class ;
    rdfs:subClassOf :Tier ,
        [ a owl:Restriction ;
          owl:onProperty :approvedBy ;
          owl:allValuesFrom :Supervisory ] .

# Approving-authority roles are pairwise disjoint: a thing approved
# by Router is NOT approved by Supervisory (and vice versa).
[] a owl:AllDisjointClasses ;
    owl:members ( :Supervisory :Router ) .

# Router never authorizes tier2 (operator policy 2026-09-09) is the
# composition of the two axioms above: Tier2 -> approvedBy only
# Supervisory, and Supervisory disjointWith Router. verify/
# check_ontology.py proves it by feeding a Router-individual-approved
# Tier2 decision to the reasoner and requiring inconsistency, plus a
# positive control (Supervisory-approved stays consistent).
# responder-executed case implies a Decision exists with approvedBy
# in {Supervisory, Router}.
